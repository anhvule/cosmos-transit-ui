# iOS deployment lanes for the CosmicTransit app.
#
# Auth strategy: App Store Connect API key for uploads to TestFlight /
# App Store. Signing material (distribution certificate .p12 + provisioning
# profile) is imported into the CI keychain by the GitHub Actions workflow
# *before* fastlane runs — see .github/workflows/ios-testflight.yml. The
# project is then built with explicit manual signing.
#
# This app has a single `Runner` target (no app extensions), so one
# distribution certificate + one App Store provisioning profile is all it needs.

default_platform(:ios)

APP_IDENTIFIER = "com.anhvule.cosmostransit".freeze

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_PRIVATE_KEY"),
      is_key_content_base64: false,
      in_house: false,
    )

    # Sync the build number to the CI run number so every upload is
    # strictly increasing and TestFlight never rejects a duplicate.
    if ENV["BUILD_NUMBER"]
      increment_build_number(
        build_number: ENV["BUILD_NUMBER"],
        xcodeproj: "Runner.xcodeproj",
      )
    end

    # Build the Flutter app first so the iOS workspace picks up the
    # generated artifacts. Fastlane runs from ios/fastlane/, so cd ../.. →
    # the Flutter project root (this repo's root).
    sh("cd ../.. && flutter pub get && cd ios && bundle exec pod install && flutter build ios --release --no-codesign")

    # Set by the workflow's "Install provisioning profile" step, derived from
    # the installed .mobileprovision. Guard against a blank value here rather
    # than letting update_code_signing_settings write an empty specifier
    # (which fails later as "Runner requires a provisioning profile").
    profile_name = ENV["IOS_PROVISIONING_PROFILE_NAME"].to_s
    UI.user_error!("IOS_PROVISIONING_PROFILE_NAME is empty — the profile install step did not export a name. Check IOS_PROVISIONING_PROFILE_BASE64.") if profile_name.strip.empty?

    # Switch the Xcode project to manual signing pinned to the profile the
    # workflow imported into ~/Library/MobileDevice/Provisioning Profiles
    # before fastlane started.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: APP_IDENTIFIER,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["Runner"],
    )

    # Diagnostic: confirm Manual signing + a non-empty specifier actually
    # landed in the project before we archive. sh runs from ios/fastlane, so
    # cd .. → ios.
    UI.message("Signing Runner with provisioning profile: '#{profile_name}'")
    sh("cd .. && grep -nE 'CODE_SIGN_STYLE|PROVISIONING_PROFILE_SPECIFIER|CODE_SIGN_IDENTITY = ' Runner.xcodeproj/project.pbxproj || true")

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Runner.ipa",
      clean: false,
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name,
        },
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
      },
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )
  end

  desc "Build and submit to App Store (manual review)"
  lane :release do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_content: ENV.fetch("APP_STORE_CONNECT_PRIVATE_KEY"),
      is_key_content_base64: false,
    )

    if ENV["BUILD_NUMBER"]
      increment_build_number(
        build_number: ENV["BUILD_NUMBER"],
        xcodeproj: "Runner.xcodeproj",
      )
    end

    sh("cd ../.. && flutter pub get && cd ios && bundle exec pod install && flutter build ios --release --no-codesign")

    # Set by the workflow's "Install provisioning profile" step, derived from
    # the installed .mobileprovision. Guard against a blank value here rather
    # than letting update_code_signing_settings write an empty specifier
    # (which fails later as "Runner requires a provisioning profile").
    profile_name = ENV["IOS_PROVISIONING_PROFILE_NAME"].to_s
    UI.user_error!("IOS_PROVISIONING_PROFILE_NAME is empty — the profile install step did not export a name. Check IOS_PROVISIONING_PROFILE_BASE64.") if profile_name.strip.empty?

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      bundle_identifier: APP_IDENTIFIER,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      targets: ["Runner"],
    )

    # Diagnostic: confirm Manual signing + a non-empty specifier actually
    # landed in the project before we archive. sh runs from ios/fastlane, so
    # cd .. → ios.
    UI.message("Signing Runner with provisioning profile: '#{profile_name}'")
    sh("cd .. && grep -nE 'CODE_SIGN_STYLE|PROVISIONING_PROFILE_SPECIFIER|CODE_SIGN_IDENTITY = ' Runner.xcodeproj/project.pbxproj || true")

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Runner.ipa",
      clean: false,
      export_options: {
        provisioningProfiles: {
          APP_IDENTIFIER => profile_name,
        },
        signingStyle: "manual",
        teamID: ENV.fetch("APPLE_TEAM_ID"),
      },
    )

    # Upload the binary to App Store Connect's production area. Metadata,
    # screenshots, and the submit-for-review click are handled manually in
    # App Store Connect — most teams keep store listing out of CI because
    # it requires human review of copy, pricing, and compliance answers
    # every release.
    upload_to_app_store(
      api_key: api_key,
      submit_for_review: false,
      skip_metadata: true,
      skip_screenshots: true,
      skip_app_version_update: true,
      force: true,
      precheck_include_in_app_purchases: false,
    )
  end
end
